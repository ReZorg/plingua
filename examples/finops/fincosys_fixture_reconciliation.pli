/*
 * fincosys membrane fixture: accospace membrane reconciliation system
 *
 * Generated by accospace/scripts/export_membrane_psystem.py -- do not edit.
 * Amounts are cents encoded as token multiplicities.
 *
 * 3 entities (labels 101..103), 4 accounts (labels 201..204), 7 statements (labels 301..307), 6 flows
 *   entity    1  AYM    Aymac International
 *   entity    2  RST    Regima Skin Treatments CC
 *   entity    3  PF     Peter Faucitt
 *   account   1  62012990132    entity AYM  master closing 33975 c
 *   account   2  4112241409     entity RST  master closing 2500 c
 *   account   3  4112241500     entity RST  master closing 6000 c
 *   account   4  55270018789    entity PF  master closing 2500 c
 *   stmt      1  account 1 no.202 2018-12-31..2019-01-31  o=10000 c=0 d=1050 z=8950  (62012990132/62012990132-202_extracted.json)
 *   stmt      2  account 1 no.203 2019-01-31..2019-02-28  o=8950 c=25025 d=0 z=33975  (62012990132/62012990132-203_extracted.json)
 *   stmt      3  account 1 no.204 2019-02-28..2019-03-30  o=33975 c=0 d=0 z=33975  (62012990132/62012990132-204_extracted.json)
 *   stmt      4  account 2 no.7 2025-09-01..2025-09-30  o=1000 c=2500 d=1500 z=2500  (4112241409/4112241409-202509_extracted.json)
 *   stmt      5  account 3 no.3 2025-09-01..2025-09-30  o=5500 c=500 d=0 z=6000  (4112241500/4112241500-202509_extracted.json)
 *   stmt      6  account 4 no.5 2025-05-01..2025-05-31  o=1000 c=1000 d=0 z=2000  (55270018789/55270018789-5_extracted.json)
 *   stmt      7  account 4 no.7 2025-07-01..2025-07-31  o=2500 c=500 d=500 z=2500  (55270018789/55270018789-7_extracted.json)
 *   flow      1  4112241409 -> 62012990132  1500 c
 *   flow      2  62012990132 -> 55270018789  1000 c
 *   flow      3  55270018789 -> 4112241409  500 c
 *   flow      4  4112241409 -> 4112241500  500 c
 *   flow      5  62012990132 -> 4112241409  300 c
 *   flow      6  4112241500 -> 55270018789  200 c  [destination leg not seen]
 */

@model<transition>
@include "../transition_model.pli"

def main()
{
  E = 3; A = 4; S = 7; R = 6;

  /* Membrane structure: ecosystem > entity > account > statement */
  @mu = [ [ [ []'301 []'302 []'303 ]'201 ]'101 [ [ []'304 ]'202 [ []'305 ]'203 ]'102 [ [ []'306 []'307 ]'204 ]'103 ]'0;

  /* Statement membranes: balance tokens, chain copies, clock */
  @ms(301) = o{1}*10000, d{1}*1050, z{1}*8950, oc{1}*10000, zc{1}*8950, k{2};
  @ms(302) = o{2}*8950, c{2}*25025, z{2}*33975, oc{2}*8950, zc{2}*33975, k{2};
  @ms(303) = o{3}*33975, z{3}*33975, oc{3}*33975, zc{3}*33975, k{2};
  @ms(304) = o{4}*1000, c{4}*2500, d{4}*1500, z{4}*2500, oc{4}*1000, zc{4}*2500, k{2};
  @ms(305) = o{5}*5500, c{5}*500, z{5}*6000, oc{5}*5500, zc{5}*6000, k{2};
  @ms(306) = o{6}*1000, c{6}*1000, z{6}*2000, oc{6}*1000, zc{6}*2000, k{2};
  @ms(307) = o{7}*2500, c{7}*500, d{7}*500, z{7}*2500, oc{7}*2500, zc{7}*2500, k{2};

  /* Account membranes: master closing balance, payment legs, clock */
  @ms(201) = ka{4}, mz{1}*33975, out{2}, flow{1,3}, tri{1,3}, out{5}, flow{1,2}, tri{1,2}, in{1};
  @ms(202) = ka{4}, mz{2}*2500, out{1}, flow{2,1}, tri{2,1}, xo{4}, in{3}, in{5};
  @ms(203) = ka{4}, mz{3}*6000, out{6}, flow{2,3}, tri{2,3}, xi{4};
  @ms(204) = ka{4}, mz{4}*2500, out{3}, flow{3,2}, tri{3,2}, in{2};

  /* Entity membranes: clock */
  @ms(101) = ke{6};
  @ms(102) = ke{6};
  @ms(103) = ke{6};

  /* Wave 1 -- every statement, synchronously: internal reconciliation
   *   o + c  vs  z + d   annihilates to |imbalance| tokens of one side */
  [o{s}, z{s} --> #]'{300+s} : 1<=s<=S;
  [c{s}, d{s} --> #]'{300+s} : 1<=s<=S;
  [o{s}, d{s} --> #]'{300+s} : 1<=s<=S;
  [c{s}, z{s} --> #]'{300+s} : 1<=s<=S;
  [k{i} --> k{i-1}]'{300+s} : 1<=s<=S, 2<=i<=2;
  [k{1} --> @d]'{300+s} : 1<=s<=S;

  /* Wave 2 -- every account, synchronously: statement chain and master balance */
  [zc{1}, oc{2} --> #]'201;
  [zc{2}, oc{3} --> #]'201;
  [zc{3}, mz{1} --> #]'201;
  [oc{1} --> #]'201;  /* first opening has no predecessor */
  [zc{4}, mz{2} --> #]'202;
  [oc{4} --> #]'202;  /* first opening has no predecessor */
  [zc{5}, mz{3} --> #]'203;
  [oc{5} --> #]'203;  /* first opening has no predecessor */
  /* account 4: statements 6 (no.5) and 7 (no.7) are not consecutive -- MISSING_WINDOW, no pairing */
  [zc{7}, mz{4} --> #]'204;
  [oc{6} --> #]'204;  /* first opening has no predecessor */
  [ka{i} --> ka{i-1}]'{200+a} : 1<=a<=A, 2<=i<=4;
  [ka{1} --> @d]'{200+a} : 1<=a<=A;

  /* Wave 3 -- every entity, synchronously: intra-entity transfers */
  [xo{r}, xi{r} --> #]'{100+e} : 1<=e<=E, 1<=r<=R;
  [ke{i} --> ke{i-1}]'{100+e} : 1<=e<=E, 2<=i<=6;
  [ke{1} --> @d]'{100+e} : 1<=e<=E;

  /* Wave 4 -- the ecosystem: inter-company legs, round trips, circular flows */
  [out{r}, in{r} --> icm{r}]'0 : 1<=r<=R;
  [flow{x,y}, flow{y,x} --> rt{x,y}]'0 : x+1<=y<=E, 1<=x<=E;
  [tri{x,y}, tri{y,w}, tri{w,x} --> cyc{x,y,w}]'0 : y != w, x+1<=w<=E, x+1<=y<=E, 1<=x<=E;
}
