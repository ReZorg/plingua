/*
 * todo_active_membranes_roundtrip_stress.pli
 * Larger SAT instance for round-trip compile/simulate stress testing.
 * P-system type: Cell-like (active membranes / membrane division)
 * Category: SAT / NP-complete
 * Complexity: L2 (intermediate)
 *
 * Uses the same Sat(m,n) module as todo_sat_active_membranes_minimal.pli
 * instantiated with n=4 variables and m=5 clauses.
 * Designed for round-trip testing: compile with plingua, simulate with psim.
 *
 * Formula:
 *   Clause 1: (x1 v x2)
 *   Clause 2: (-x1 v x3)
 *   Clause 3: (x2 v -x3 v x4)
 *   Clause 4: (-x2 v -x4)
 *   Clause 5: (x1 v x3 v -x4)
 *
 * Input encoding (in membrane 2):
 *   x{i,j}  = variable j appears POSITIVE in clause i
 *   nx{i,j} = variable j appears NEGATIVE in clause i
 *
 *   Clause 1 (i=1): x1 positive -> x{1,1};  x2 positive -> x{1,2}
 *   Clause 2 (i=2): x1 negative -> nx{2,1}; x3 positive -> x{2,3}
 *   Clause 3 (i=3): x2 positive -> x{3,2};  x3 negative -> nx{3,3}; x4 positive -> x{3,4}
 *   Clause 4 (i=4): x2 negative -> nx{4,2}; x4 negative -> nx{4,4}
 *   Clause 5 (i=5): x1 positive -> x{5,1};  x3 positive -> x{5,3};  x4 negative -> nx{5,4}
 *
 * Satisfying assignment (one of several): x1=T, x2=T, x3=T, x4=F
 *   Clause 1: x1=T             -> T
 *   Clause 2: -x1 v x3 = F v T -> T
 *   Clause 3: x2 v -x3 v x4 = T v F v F -> T  (satisfied by x2=T)
 *   Clause 4: -x2 v -x4 = F v T          -> T  (satisfied by x4=F)
 *   Clause 5: x1 v x3 v -x4 = T v T v T  -> T
 * Expected result: object 'Yes' appears in the skin membrane (label 1).
 *
 * Reference:
 *   Perez-Jimenez, Romero-Jimenez, Sancho-Caparrini,
 *   "Complexity classes in models of cellular computing with membranes",
 *   Natural Computing 2(3), 265-285 (2003).
 */
@model<membrane_division>
@include "membrane_division_model.pli"

/* ------------------------------------------------------------------ */
/* Sat(m, n) module: m clauses, n propositional variables              */
/*                                                                     */
/* Adapted from sat_cell_division0.pli (Ignacio Perez-Hurtado, 2008). */
/* ------------------------------------------------------------------ */
def Sat(m,n)
{
  /* Initial configuration */
  @mu = [[]'2]'1;

  /* Initial multisets */
  @ms(2) = d{1};

  /* Membrane division: generate 2^n membranes (one per truth assignment) */
  [d{k}]'2 --> +[d{k}]-[d{k}] : 1 <= k <= n;

  /* Assign truth values to variables (positive literals) */
  {
    +[x{i,1} --> r{i,1}]'2;
    -[nx{i,1} --> r{i,1}]'2;
    -[x{i,1} --> #]'2;
    +[nx{i,1} --> #]'2;
  } : 1 <= i <= m;

  /* Propagate literals across variables */
  {
    +[x{i,j} --> x{i,j-1}]'2;
    -[x{i,j} --> x{i,j-1}]'2;
    +[nx{i,j} --> nx{i,j-1}]'2;
    -[nx{i,j} --> nx{i,j-1}]'2;
  } : 1<=i<=m, 2<=j<=n;

  /* Release division labels */
  {
    +[d{k}]'2 --> []d{k};
    -[d{k}]'2 --> []d{k};
  } : 1<=k<=n;

  d{k}[]'2 --> [d{k+1}] : 1<=k<=n-1;

  /* Collect satisfied clause witnesses */
  [r{i,k} --> r{i,k+1}]'2 : 1<=i<=m, 1<=k<=2*n-1;

  /* Step through the skin clock */
  [d{k} --> d{k+1}]'1 : n <= k <= 3*n-3;
  [d{3*n-2} --> d{3*n-1},e]'1;
  e[]'2 --> +[c{1}];
  [d{3*n-1} --> d{3*n}]'1;
  [d{k} --> d{k+1}]'1 : 3*n <= k <= 3*n+2*m+2;

  /* Check if all clauses are satisfied */
  +[r{1,2*n}]'2 --> -[]r{1,2*n};
  r{1,2*n}-[]'2 --> +[r{0,2*n}];
  -[r{i,2*n} --> r{i-1,2*n}]'2 : 1<= i <= m;
  -[c{k} --> c{k+1}]'2 : 1<=k<=m;
  +[c{m+1}]'2 --> +[]c{m+1};
  [c{m+1} --> c{m+2},t]'1;
  [t]'1 --> +[]t;
  +[c{m+2}]'1 --> -[]Yes;

  /* Output No if unsatisfiable */
  [d{3*n+2*m+3}]'1 --> +[]No;

} /* End of Sat module */

/* ------------------------------------------------------------------ */
/* Main: instantiate Sat for 5 clauses and 4 variables                 */
/* ------------------------------------------------------------------ */
def main()
{
  /* Call Sat with m=5 clauses, n=4 variables */
  call Sat(5,4);

  /* Input multiset for 5-clause 4-variable formula */
  @ms(2) += x{1,1}, x{1,2},              /* Clause 1: x1 v x2        */
            nx{2,1}, x{2,3},             /* Clause 2: -x1 v x3       */
            x{3,2}, nx{3,3}, x{3,4},    /* Clause 3: x2 v -x3 v x4  */
            nx{4,2}, nx{4,4},            /* Clause 4: -x2 v -x4      */
            x{5,1}, x{5,3}, nx{5,4};    /* Clause 5: x1 v x3 v -x4  */

} /* End of main module */
